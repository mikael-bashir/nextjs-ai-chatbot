# Storage (mount as volumes in prod so data/model survive redeploys)
EST_DB_PATH=./data/runs.db
EST_MODEL_DIR=./models
# Embeddings: local model name; falls back to hashing if not installed
EST_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EST_EMBED_ENABLED=1
# Reject gate defaults
EST_DEFAULT_BUDGET_USD=5.0
EST_DEFAULT_MIN_PROVE_PROB=0.25
EST_MIN_TRAIN_ROWS=25
# For scripts/seed_from_leak.py only
# REDIS_URL=rediss://…
